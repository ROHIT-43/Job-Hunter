# Copy this file to `.env` and fill in your real token.
# `.env` is git-ignored, so secrets never land in the repo.
#
# Get an Apify API token at: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only if you use the Adzuna source in scripts/fetch_jobs.py
# (free key at https://developer.adzuna.com)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
