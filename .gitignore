# ── Personal data + all I/O — NEVER commit ────────────────────────────────
# This repo is the reusable skill only. The data/ folder holds your real
# candidate profile (data/profile.json), raw job exports, and every generated
# report (data/output/). It is fully ignored — use assets/candidate.example.json
# as the tracked template.
data/

# Personal resumes (generated per-candidate, not shared)
resumes/*.tex
resumes/*.pdf
!resumes/README.md

# Job dumps from scripts/fetch_jobs.py (default --out) and the live site's data
# (site/data/ is also covered by data/ above; the workflow publishes it to Pages).
/jobs.json
site/data/

# Belt-and-suspenders in case scripts are run from the repo root:
profile.json
profile.*.json
!*.example.json
master.md
bullet_bank.md
*tracker*.md
linkedin_assets.md
linkedin_*.json
*_results.json
apify_*.json
ats_full_report.md
ats_full_report.csv
ats_match_report.md
*_report.md
*_report.csv
hunts/

# Claude Code per-machine permissions (local paths, one-off approvals)
.claude/settings.local.json

# Obsidian vault config (if run inside one)
.obsidian/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets — keep the token out, but track the template
.env
!.env.example

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

candidate_profile.json